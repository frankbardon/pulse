          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m08",
            "expression": "order_date >= 20301 && order_date < 20332 ? 1 : 0"
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m09",
            "expression": "order_date >= 20332 && order_date < 20362 ? 1 : 0"
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m10",
            "expression": "order_date >= 20362 && order_date < 20393 ? 1 : 0"
          },
