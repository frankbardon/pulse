          }
        ],
        "groups": [
          {
            "type": "GROUP_CATEGORY",
            "field": "customer_id"
          }
        ],
        "aggregations": [
          {
            "type": "AGG_SUM",
            "field": "net_amount",
            "label": "spend"
          },
          {
            "type": "AGG_DISTINCT_COUNT",
            "field": "order_id",
            "label": "orders"
          },
          {
