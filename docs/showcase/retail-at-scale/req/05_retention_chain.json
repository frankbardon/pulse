{
  "cohort": {
    "filename": "orders.pulse",
    "data_dir": "."
  },
  "stages": [
    {
      "name": "per_customer",
      "request": {
        "filterers": [
          {
            "type": "FILTER_EXPRESSION",
            "expression": "customer_id % 10 == 0"
          }
        ],
        "attributes": [
          {
            "type": "ATTR_DATE_PART",
            "field": "order_date",
            "label": "month",
            "params": {
              "part": "year_month"
            }
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m01",
            "expression": "order_date >= 20089 && order_date < 20120 ? 1 : 0"
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m02",
            "expression": "order_date >= 20120 && order_date < 20148 ? 1 : 0"
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m03",
            "expression": "order_date >= 20148 && order_date < 20179 ? 1 : 0"
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m04",
            "expression": "order_date >= 20179 && order_date < 20209 ? 1 : 0"
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
            "label": "in_m05",
            "expression": "order_date >= 20209 && order_date < 20240 ? 1 : 0"
          },
          {
            "type": "ATTR_FORMULA",
            "field": "order_date",
