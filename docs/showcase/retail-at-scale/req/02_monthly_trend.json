{
  "cohort": {"filename": "orders.pulse", "data_dir": "."},
  "attributes": [
    {"type": "ATTR_DATE_PART", "field": "order_date", "label": "month", "params": {"part": "year_month"}},
    {"type": "ATTR_FORMULA", "field": "channel", "label": "is_online", "expression": "channel == \"online\" ? 1 : 0"}
  ],
  "groups": [{"type": "GROUP_CATEGORY", "field": "month"}],
  "aggregations": [
    {"type": "AGG_COUNT", "field": "line_id", "label": "lines"},
    {"type": "AGG_SUM", "field": "net_amount", "label": "revenue"},
    {"type": "AGG_AVERAGE", "field": "net_amount", "label": "avg_line_value"},
    {"type": "AGG_AVERAGE", "field": "is_online", "label": "online_share"}
  ],
  "sort": [{"field": "month"}]
}
