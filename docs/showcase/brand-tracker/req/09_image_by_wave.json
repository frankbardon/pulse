{
  "cohort": {
    "filename": "brand_tracker.pulse",
    "data_dir": "."
  },
  "weight": {
    "field": "weight",
    "kind": "probability"
  },
  "filterers": [
    {
      "type": "FILTER_NULL",
      "field": "attributes",
      "values": [
        "is_not_null"
      ]
    }
  ],
  "crosstab": {
    "rows": [
      {
        "type": "GROUP_SET_PER_ELEMENT",
        "field": "attributes"
      }
    ],
    "columns": [
      {
        "type": "GROUP_CATEGORY",
        "field": "wave"
      }
    ],
    "cell": {
      "type": "AGG_COUNT",
      "field": "resp_id",
      "label": "share"
    },
    "normalize": "column",
    "margins": {
      "columns": true
    }
  },
  "labels": [
    {
      "field": "wave",
      "table": "wave_names",
      "mode": "replace"
    }
  ]
}
