  "rules": [
    {
      "set_expr": {
        "weight": "(wave == \"W4\" ? (age_band == \"18-34\" ? 0.5 : (age_band == \"35-54\" ? 1.178571 : 2.714286)) : (age_band == \"18-34\" ? 0.725 : (age_band == \"35-54\" ? 0.916667 : 1.583333))) * (gender == \"Female\" ? 0.927273 : 1.088889) * (region == \"NE\" ? 0.85 : (region == \"MW\" ? 0.954545 : (region == \"SO\" ? 1.055556 : 1.090909)))"
      }
    },
    {
      "when": "aware_unaided == 1",
      "set": {
        "aware_aided": 1
      }
    },
    {
      "when": "aware_aided == 0",
      "set_null": [
        "consider",
        "intent",
        "nps",
        "attributes"
      ]
    },
    {
      "when": "!isnull(attributes) && !attributes[\"Good value\"] && !attributes[\"High quality\"] && !attributes[\"Innovative\"] && !attributes[\"Trustworthy\"] && !attributes[\"Stylish\"] && !attributes[\"Eco-friendly\"] && !attributes[\"For people like me\"]",
      "set": {
        "attributes": [
          "None of these"
        ]
      }
    }
  ]
