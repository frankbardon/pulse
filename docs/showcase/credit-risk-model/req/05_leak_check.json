{
  "cohort": {
    "filename": "loans.pulse",
    "data_dir": "."
  },
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "outcome"
    }
  ],
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "loan_id",
      "label": "applications"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "fico_score",
      "label": "mean_fico_at_application"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "fico_at_month_12",
      "label": "mean_fico_at_month_12"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "collections_flag",
      "label": "collections_rate"
    },
    {
      "type": "AGG_COUNT",
      "field": "recovery_amount",
      "label": "loans_with_recovery"
    },
    {
      "type": "AGG_SUM",
      "field": "recovery_amount",
      "label": "recovered_usd"
    }
  ]
}
