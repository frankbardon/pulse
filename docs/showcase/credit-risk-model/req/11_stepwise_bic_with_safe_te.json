{
  "cohort": {
    "filename": "loans.pulse",
    "data_dir": "."
  },
  "features": [
    {
      "type": "FEAT_TRAIN_TEST_SPLIT",
      "label": "split",
      "params": {
        "ratios": [
          0.7,
          0.3
        ],
        "seed": 42,
        "stratify": "outcome"
      }
    },
    {
      "type": "FEAT_LOG",
      "field": "annual_income",
      "label": "log_income"
    },
    {
      "type": "FEAT_LOG",
      "field": "loan_amount",
      "label": "log_loan"
    },
    {
      "type": "FEAT_ONE_HOT",
      "field": "credit_band",
      "label": "band"
    },
    {
      "type": "FEAT_ONE_HOT",
      "field": "home_ownership",
      "label": "home"
    },
    {
      "type": "FEAT_FREQUENCY_ENCODE",
      "field": "purpose",
      "label": "purpose_freq"
    }
  ],
  "attributes": [
    {
      "type": "ATTR_FORMULA",
      "label": "lti",
