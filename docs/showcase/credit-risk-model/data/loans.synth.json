{
  "row_count": 60000,
  "fields": [
    {
      "name": "loan_id",
      "type": "u32",
      "description": "Application identifier.",
      "distribution": "monotonic_from",
      "params": {
        "start": 100001
      }
    },
    {
      "name": "application_date",
      "type": "date",
      "description": "Date the application was booked.",
      "distribution": "uniform_date",
      "params": {
        "start": "2022-01-01",
        "end": "2024-06-30"
      }
    },
    {
      "name": "state",
      "type": "categorical_u8",
      "description": "Borrower state of residence (two-letter code; OTHER pools the long tail).",
      "distribution": "weighted_categorical",
      "params": {
        "values": [
          "CA",
          "TX",
          "NY",
          "FL",
          "IL",
          "PA",
          "OH",
          "GA",
          "NC",
          "MI",
          "NJ",
          "VA",
          "WA",
          "AZ",
          "MA",
          "OTHER"
        ],
        "weights": [
          0.14,
