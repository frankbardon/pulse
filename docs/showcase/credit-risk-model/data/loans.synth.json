          0.07,
          0.04,
          0.04,
          0.035,
          0.035,
          0.03,
          0.03,
          0.03,
          0.03,
          0.03,
          0.025,
          0.025,
          0.29
        ]
      }
    },
    {
      "name": "purpose",
      "type": "categorical_u8",
      "description": "Stated loan purpose from the application form (40 levels, long tail).",
      "distribution": "weighted_categorical",
      "params": {
        "values": [
          "debt_consolidation",
          "credit_card",
          "home_improvement",
          "other",
          "major_purchase",
          "medical",
          "small_business",
          "car",
          "moving",
          "vacation",
          "house",
          "wedding",
          "renewable_energy",
          "educational",
          "boat",
