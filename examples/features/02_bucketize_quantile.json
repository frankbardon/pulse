{
  "_meta": {
    "category": "features",
    "description": "Discretize income into ten equal-frequency buckets and count rows per decile.",
    "name": "feat_bucketize_quantile",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "FEAT_BUCKETIZE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "feature-engineering",
      "pre-filter",
      "feature-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "income",
      "label": "mean_income"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_BUCKETIZE",
      "field": "income",
      "label": "income_decile",
      "params": {
        "quantiles": 10
      }
    }
  ],
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "income_decile"
    }
  ],
  "sort": [
    {
      "field": "income_decile"
    }
  ]

}
