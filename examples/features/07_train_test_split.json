{
  "_meta": {
    "category": "features",
    "description": "Apply a stratified 70/15/15 train/val/test split and verify partition sizes via group counts.",
    "name": "feat_train_test_split_stratified",
    "operators": [
      "AGG_COUNT",
      "FEAT_TRAIN_TEST_SPLIT",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "feature-engineering",
      "feature-pipeline",
      "leakage-safe",
      "pre-filter"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    }
  ],
  "cohort": {
    "filename": "training_data.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_TRAIN_TEST_SPLIT",
      "params": {
        "ratios": [
          0.7,
          0.15,
          0.15
        ],
        "seed": 42,
        "stratify": "category"
      }
    }
  ],
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "split"
    }
  ],
  "sort": [
    {
      "field": "split"
    }
  ]

}
