{
  "_meta": {
    "category": "features",
    "description": "Log-transform a skewed numeric column and summarize the resulting distribution.",
    "name": "feat_log_transform",
    "operators": [
      "AGG_AVERAGE",
      "AGG_STDDEV",
      "FEAT_LOG"
    ],
    "tags": [
      "feature-engineering",
      "distribution-shape",
      "pre-filter",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "log_amount",
      "label": "mean_log_amount"
    },
    {
      "type": "AGG_STDDEV",
      "field": "log_amount",
      "label": "stddev_log_amount"
    }
  ],
  "cohort": {
    "filename": "transactions.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_LOG",
      "field": "amount",
      "label": "log_amount"
    }
  ]

}
