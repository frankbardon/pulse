{
  "_comment": "Decompose order_date into calendar features, then group by quarter and day-of-week to see seasonality.",
  "cohort": {
    "filename": "orders.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_DATE_FEATURES",
      "field": "order_date"
    }
  ],
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "order_date_quarter"
    }
  ],
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n_orders"
    },
    {
      "type": "AGG_SUM",
      "field": "revenue",
      "label": "total_revenue"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "order_date_dow",
      "label": "avg_dow"
    }
  ],
  "sort": [
    {
      "field": "order_date_quarter"
    }
  ]
}