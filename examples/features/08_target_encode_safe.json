{
  "_meta": {
    "category": "features",
    "description": "Leakage-safe target encoding that runs FEAT_TRAIN_TEST_SPLIT before FEAT_TARGET_ENCODE so the leakage gate stays silent.",
    "name": "feat_target_encode_safe",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "FEAT_TARGET_ENCODE",
      "FEAT_TRAIN_TEST_SPLIT",
      "FILTER_INCLUDE"
    ],
    "tags": [
      "feature-engineering",
      "feature-pipeline",
      "leakage-safe",
      "pre-filter"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "category_target_mean",
      "label": "avg_encoded"
    },
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n_train"
    }
  ],
  "cohort": {
    "filename": "training_data.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_TRAIN_TEST_SPLIT",
      "params": {
        "ratios": [
          0.7,
          0.15,
          0.15
        ],
        "seed": 42
      }
    },
    {
      "type": "FEAT_TARGET_ENCODE",
      "field": "category",
      "label": "category_target_mean",
      "params": {
        "target": "price",
        "smoothing": 5.0
      }
    }
  ],
  "filterers": [
    {
      "type": "FILTER_INCLUDE",
      "field": "split",
      "values": [
        "0"
      ]
    }
  ]

}
