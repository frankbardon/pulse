{
  "_meta": {
    "category": "tests",
    "description": "Welch ANOVA on revenue across regions to handle heteroscedasticity without inflating type-I error.",
    "name": "welch_anova_unequal_var",
    "operators": [
      "AGG_AVERAGE",
      "TEST_ANOVA_WELCH"
    ],
    "tags": [
      "hypothesis-test",
      "tier-1-test",
      "parametric",
      "k-sample",
      "experiment-analysis",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "revenue",
      "label": "avg_revenue"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "tests": [
    {
      "type": "TEST_ANOVA_WELCH",
      "field": "revenue",
      "split_by": "region",
      "alpha": 0.05,
      "label": "revenue_welch_anova"
    }
  ]

}
