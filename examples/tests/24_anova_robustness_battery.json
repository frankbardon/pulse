{
  "_meta": {
    "category": "tests",
    "description": "ANOVA robustness battery: equal-variance F, Welch's F, and Brown-Forsythe on the same revenue-by-region split.",
    "name": "anova_robustness_battery",
    "operators": [
      "AGG_AVERAGE",
      "TEST_ANOVA_F",
      "TEST_ANOVA_WELCH",
      "TEST_BROWN_FORSYTHE"
    ],
    "tags": [
      "hypothesis-test",
      "tier-1-test",
      "parametric",
      "k-sample",
      "homogeneity-test",
      "experiment-analysis",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "revenue",
      "label": "avg_revenue"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "tests": [
    {
      "type": "TEST_ANOVA_F",
      "field": "revenue",
      "split_by": "region",
      "alpha": 0.05,
      "label": "anova_f"
    },
    {
      "type": "TEST_ANOVA_WELCH",
      "field": "revenue",
      "split_by": "region",
      "alpha": 0.05,
      "label": "anova_welch"
    },
    {
      "type": "TEST_BROWN_FORSYTHE",
      "field": "revenue",
      "split_by": "region",
      "alpha": 0.05,
      "label": "brown_forsythe"
    }
  ]

}
