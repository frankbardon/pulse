{
  "_meta": {
    "category": "tests",
    "description": "Tier-2 ANOVA reconstructed from per-region summary stats (mean, n, variance) produced by an upstream GROUP_CATEGORY aggregation.",
    "name": "post_anova_on_grouped_means",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "AGG_VARIANCE",
      "GROUP_CATEGORY",
      "TEST_ANOVA_F"
    ],
    "tags": [
      "hypothesis-test",
      "tier-2-test",
      "parametric",
      "k-sample",
      "post-hoc",
      "comparison",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "revenue",
      "label": "avg_revenue"
    },
    {
      "type": "AGG_VARIANCE",
      "field": "revenue",
      "label": "var_revenue"
    },
    {
      "type": "AGG_COUNT",
      "field": "revenue",
      "label": "n"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "region"
    }
  ],
  "post_tests": [
    {
      "type": "TEST_ANOVA_F",
      "field": "avg_revenue",
      "split_by": "region",
      "alpha": 0.05,
      "label": "region_anova_from_groups",
      "params": {
        "n_col": "n",
        "variance_col": "var_revenue"
      }
    }
  ]

}
