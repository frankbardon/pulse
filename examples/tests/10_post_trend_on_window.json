{
  "_meta": {
    "category": "tests",
    "description": "Tier-2 Mann-Kendall trend test applied to a 7-day windowed moving average of daily revenue.",
    "name": "post_trend_on_window",
    "operators": [
      "AGG_AVERAGE",
      "GROUP_DATE",
      "TEST_TREND",
      "WIN_MOVING_AVG"
    ],
    "tags": [
      "hypothesis-test",
      "tier-2-test",
      "nonparametric",
      "trend-detection",
      "time-series",
      "window-operator",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "revenue",
      "label": "avg_revenue"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_DATE",
      "field": "period",
      "params": {
        "component": "day"
      }
    }
  ],
  "post_tests": [
    {
      "type": "TEST_TREND",
      "field": "ma7_revenue",
      "alpha": 0.05,
      "label": "smoothed_revenue_trend",
      "order_by": [
        {
          "field": "period"
        }
      ],
      "params": {
        "variant": "mann_kendall"
      }
    }
  ],
  "sort": [
    {
      "field": "period"
    }
  ],
  "windows": [
    {
      "type": "WIN_MOVING_AVG",
      "field": "avg_revenue",
      "label": "ma7_revenue",
      "order_by": [
        {
          "field": "period"
        }
      ],
      "frame": {
        "mode": "rows",
        "preceding": 6,
        "following": 0
      }
    }
  ]

}
