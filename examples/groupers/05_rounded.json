{
  "_meta": {
    "category": "groupers",
    "description": "Bucket age into decades via floor(age/10)*10 and report count and average income per decade.",
    "name": "group_rounded_decade",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "GROUP_ROUNDED"
    ],
    "tags": [
      "cohort-analysis",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "income",
      "label": "avg_income"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_ROUNDED",
      "field": "age",
      "interval": 10
    }
  ],
  "sort": [
    {
      "field": "age"
    }
  ]

}
