{
  "_meta": {
    "category": "groupers",
    "description": "Group rows into H3 cells at resolution 5, converting each point_f64 to its cell on the fly.",
    "name": "group_h3_cell_from_point",
    "operators": [
      "AGG_COUNT",
      "AGG_GEO_CENTROID",
      "GROUP_H3_CELL"
    ],
    "tags": [
      "geo-analysis",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    },
    {
      "type": "AGG_GEO_CENTROID",
      "field": "location",
      "label": "cell_center"
    }
  ],
  "cohort": {
    "filename": "all_types.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_H3_CELL",
      "field": "location",
      "params": {
        "resolution": 5
      }
    }
  ]

}
