{
  "_comment": "Income quartiles. interval=4 yields keys Q1..Q4; interval=10 yields D1..D10; interval=100 yields P1..P100.",
  "cohort": {"filename": "customers.pulse", "data_dir": ".data"},
  "groups": [
    {"type": "GROUP_QUANTILE", "field": "income", "interval": 4}
  ],
  "aggregations": [
    {"type": "AGG_COUNT", "field": "id", "label": "n"},
    {"type": "AGG_AVERAGE", "field": "income", "label": "avg_income"},
    {"type": "AGG_MIN", "field": "income", "label": "min_income"},
    {"type": "AGG_MAX", "field": "income", "label": "max_income"}
  ],
  "sort": [{"field": "income"}]
}
