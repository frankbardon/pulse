{
  "_meta": {
    "category": "aggregations",
    "description": "Compute the unit-sphere centroid and bounding box of a point_f64 cohort, rejecting input sets that straddle the antimeridian.",
    "name": "geo_centroid_bbox",
    "operators": [
      "AGG_GEO_BBOX",
      "AGG_GEO_CENTROID"
    ],
    "tags": [
      "geo-analysis",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_GEO_CENTROID",
      "field": "location",
      "label": "centroid"
    },
    {
      "type": "AGG_GEO_BBOX",
      "field": "location",
      "label": "bbox"
    }
  ],
  "cohort": {
    "filename": "all_types.pulse",
    "data_dir": ".data"
  }

}
