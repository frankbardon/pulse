{
  "_comment": "Numeric range filter: age in [25, 55] inclusive. The values array is [min, max] as strings; predict accepts numeric coercion.",
  "cohort": {"filename": "customers.pulse", "data_dir": ".data"},
  "filterers": [
    {"type": "FILTER_RANGE", "field": "age", "values": ["25", "55"]}
  ],
  "aggregations": [
    {"type": "AGG_COUNT", "field": "id", "label": "n"},
    {"type": "AGG_MIN", "field": "age", "label": "min_age"},
    {"type": "AGG_MAX", "field": "age", "label": "max_age"},
    {"type": "AGG_AVERAGE", "field": "income", "label": "avg_income"}
  ]
}
