{
  "_meta": {
    "category": "filterers",
    "description": "Distance filter retaining rows within 50 km of San Francisco using a WKT anchor and a radius in meters.",
    "name": "filter_geo_within_radius",
    "operators": [
      "AGG_COUNT",
      "FILTER_GEO_WITHIN_RADIUS_M"
    ],
    "tags": [
      "geo-analysis",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "near_sf"
    }
  ],
  "cohort": {
    "filename": "all_types.pulse",
    "data_dir": ".data"
  },
  "filterers": [
    {
      "type": "FILTER_GEO_WITHIN_RADIUS_M",
      "field": "location",
      "expression": "{\"anchor\": \"POINT(-122.418 37.775)\", \"radius_m\": 50000}"
    }
  ]

}
