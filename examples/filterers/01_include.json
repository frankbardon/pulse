{
  "_meta": {
    "category": "filterers",
    "description": "Keep only customers in the north or south regions, then count survivors by region.",
    "name": "filter_include_regions",
    "operators": [
      "AGG_COUNT",
      "FILTER_INCLUDE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "comparison",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "filterers": [
    {
      "type": "FILTER_INCLUDE",
      "field": "region",
      "values": [
        "north",
        "south"
      ]
    }
  ],
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "region"
    }
  ],
  "sort": [
    {
      "field": "region"
    }
  ]

}
