{
  "_meta": {
    "category": "attributes",
    "description": "Compute per-record z-scores on income and summarize the distribution of the standardized values.",
    "name": "zscore",
    "operators": [
      "AGG_AVERAGE",
      "AGG_MAX",
      "AGG_MIN",
      "ATTR_ZSCORE"
    ],
    "tags": [
      "outlier-detection",
      "distribution-shape",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_MIN",
      "field": "income_z",
      "label": "min_z"
    },
    {
      "type": "AGG_MAX",
      "field": "income_z",
      "label": "max_z"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "income_z",
      "label": "mean_z"
    }
  ],
  "attributes": [
    {
      "type": "ATTR_ZSCORE",
      "field": "income",
      "label": "income_z"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  }

}
