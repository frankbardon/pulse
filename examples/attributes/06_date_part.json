{
  "_comment": "Extract year_month from order_date as YYYYMM integer, then group on it for monthly trends.",
  "cohort": {"filename": "orders.pulse", "data_dir": ".data"},
  "attributes": [
    {
      "type": "ATTR_DATE_PART",
      "field": "order_date",
      "label": "yyyymm",
      "params": {"part": "year_month"}
    }
  ],
  "groups": [
    {"type": "GROUP_CATEGORY", "field": "yyyymm"}
  ],
  "aggregations": [
    {"type": "AGG_COUNT", "field": "id", "label": "n"},
    {"type": "AGG_SUM", "field": "revenue", "label": "total"}
  ],
  "sort": [{"field": "yyyymm"}]
}
