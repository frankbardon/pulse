{
  "_comment": "Rank customers by income within each region. partition_by ensures rank resets per region. RANK has gaps on ties (1,2,2,4,...).",
  "cohort": {"filename": "customers.pulse", "data_dir": ".data"},
  "windows": [
    {
      "type": "WIN_RANK",
      "label": "income_rank_in_region",
      "partition_by": ["region"],
      "order_by": [{"field": "income", "desc": true}]
    }
  ],
  "sort": [{"field": "region"}, {"field": "income_rank_in_region"}]
}
