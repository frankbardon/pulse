    "follow_ups": [
      {
        "when": "the groups differ and you want to know which pairs of groups do",
        "use": "TEST_TUKEY_HSD"
      },
      {
        "when": "the groups are the rows of a crosstab of averages and you want every pair tested",
        "use": "OVERLAY_PAIRWISE_WELCH_T"
      }
    ],
    "caveats": [
      "TEST_ANOVA_F has a stated validation gap; read it in validation.gap before relying on the figures it names.",
      "TEST_ANOVA_F: Rows are independent of each other, within and across groups.",
      "TEST_ANOVA_F: The measure is roughly normally distributed within each group.",
      "TEST_ANOVA_F: Groups have similar variances; TEST_BROWN_FORSYTHE checks this.",
      "TEST_ANOVA_F: It is an overall test: it says whether any group average stands apart, not which one."
    ],
    "validation": {
      "references": [
        {
