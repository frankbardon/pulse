{
  "id": "segment_revenue_bands",
  "intent": "segment",
  "question": "Split the experiment's people into four equal-sized bands by revenue, from lowest to highest spenders, and show the average session length in each band.",
  "cohorts": ["experiment"],
  "reference": {
    "tool": "pulse_process",
    "arguments": {
      "cohort": {"filename": "experiment.pulse"},
      "groups": [{"type": "GROUP_QUANTILE", "field": "revenue", "interval": 4}],
      "aggregations": [{"type": "AGG_AVERAGE", "field": "session_minutes"}]
    }
  },
  "assertions": [
    {"kind": "operator", "any_of": ["GROUP_QUANTILE"]},
    {"kind": "rows", "section": "data", "count": 4},
    {"kind": "value", "section": "data", "in_row": ["Q1"], "metric": {"types": ["AGG_AVERAGE"], "field": "session_minutes"}, "near": 13.3536, "tol": 0.005},
    {"kind": "value", "section": "data", "in_row": ["Q2"], "metric": {"types": ["AGG_AVERAGE"], "field": "session_minutes"}, "near": 14.1362, "tol": 0.005},
    {"kind": "value", "section": "data", "in_row": ["Q3"], "metric": {"types": ["AGG_AVERAGE"], "field": "session_minutes"}, "near": 13.6763, "tol": 0.005},
    {"kind": "value", "section": "data", "in_row": ["Q4"], "metric": {"types": ["AGG_AVERAGE"], "field": "session_minutes"}, "near": 14.9118, "tol": 0.005}
  ]
}
