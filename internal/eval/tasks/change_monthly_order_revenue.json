{
  "id": "change_monthly_order_revenue",
  "intent": "change_over_time",
  "question": "How did total order revenue move month by month through 2025, and which month was the best?",
  "cohorts": ["orders"],
  "reference": {
    "tool": "pulse_process",
    "arguments": {
      "cohort": {"filename": "orders.pulse"},
      "groups": [{"type": "GROUP_DATE", "field": "order_date", "params": {"frequency": "month"}}],
      "aggregations": [{"type": "AGG_SUM", "field": "revenue"}]
    }
