    {"kind": "value", "section": "data", "metric": {"types": ["AGG_SUM"], "field": "revenue"}, "near": 16551.35, "tol": 1},
    {"kind": "top", "section": "data", "metric": {"types": ["AGG_SUM"], "field": "revenue"}, "value": "2025-07"}
  ]
}
