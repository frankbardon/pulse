{
  "params": {
    "mult_tv": {
      "$var": "mult_tv"
    },
    "mean_tv": {
      "$var": "mean_tv"
    },
    "lo_tv": {
      "$var": "lo_tv"
    },
    "hi_tv": {
      "$var": "hi_tv"
    },
    "mult_search": {
      "$var": "mult_search"
    },
    "mean_search": {
      "$var": "mean_search"
    },
    "lo_search": {
      "$var": "lo_search"
    },
    "hi_search": {
      "$var": "hi_search"
    },
    "mult_social": {
      "$var": "mult_social"
    },
    "mean_social": {
      "$var": "mean_social"
    },
    "lo_social": {
      "$var": "lo_social"
    },
    "hi_social": {
      "$var": "hi_social"
    },
    "mult_display": {
      "$var": "mult_display"
    },
    "mean_display": {
      "$var": "mean_display"
    },
    "lo_display": {
      "$var": "lo_display"
    },
    "hi_display": {
      "$var": "hi_display"
    },
    "budget": {
      "$var": "budget"
    }
  },
  "fits": [
    {
      "name": "mmm",
      "request": {
        "cohort": {
          "filename": "mmm_joint.pulse"
        },
        "windows": [
          {
            "type": "WIN_DISTRIBUTED_LAG",
            "field": "tv",
            "label": "tv_ad",
            "order_by": [
              {
                "field": "week"
              }
            ],
            "params": {
              "kernel": "geometric",
              "decay": {
                "$var": "decay_tv"
              },
              "max_lag": 13,
              "normalize": false
            }
          },
          {
            "type": "WIN_DISTRIBUTED_LAG",
            "field": "search",
            "label": "search_ad",
            "order_by": [
              {
                "field": "week"
              }
            ],
            "params": {
              "kernel": "geometric",
              "decay": {
                "$var": "decay_search"
              },
              "max_lag": 13,
              "normalize": false
            }
          },
          {
            "type": "WIN_DISTRIBUTED_LAG",
            "field": "social",
            "label": "social_ad",
            "order_by": [
              {
                "field": "week"
              }
            ],
            "params": {
              "kernel": "geometric",
              "decay": {
                "$var": "decay_social"
              },
              "max_lag": 13,
              "normalize": false
            }
          },
          {
            "type": "WIN_DISTRIBUTED_LAG",
            "field": "display",
            "label": "display_ad",
            "order_by": [
              {
                "field": "week"
              }
            ],
            "params": {
              "kernel": "geometric",
              "decay": {
                "$var": "decay_display"
              },
              "max_lag": 13,
              "normalize": false
            }
          }
        ],
        "regressions": [
          {
            "type": "REG_MMM_HILL",
            "name": "mmm",
            "target": "sales",
            "predictors": [
              "tv_ad",
              "search_ad",
              "social_ad",
              "display_ad",
              "price",
              "promo"
            ],
            "params": {
              "channels": [
                "tv_ad",
                "search_ad",
                "social_ad",
                "display_ad"
              ]
            }
          }
        ]
      }
    }
  ],
  "requests": [
    {
      "label": "contributions",
      "cohort": {
        "filename": "mmm_joint.pulse"
      },
      "windows": [
        {
          "type": "WIN_DISTRIBUTED_LAG",
          "field": "tv",
          "label": "tv_ad",
          "order_by": [
            {
              "field": "week"
            }
          ],
          "params": {
            "kernel": "geometric",
            "decay": {
              "$var": "decay_tv"
            },
            "max_lag": 13,
            "normalize": false
          }
        },
        {
          "type": "WIN_DISTRIBUTED_LAG",
          "field": "search",
          "label": "search_ad",
          "order_by": [
            {
              "field": "week"
            }
          ],
          "params": {
            "kernel": "geometric",
            "decay": {
              "$var": "decay_search"
            },
            "max_lag": 13,
            "normalize": false
          }
        },
        {
          "type": "WIN_DISTRIBUTED_LAG",
          "field": "social",
          "label": "social_ad",
          "order_by": [
            {
              "field": "week"
            }
          ],
          "params": {
            "kernel": "geometric",
            "decay": {
              "$var": "decay_social"
            },
            "max_lag": 13,
            "normalize": false
          }
        },
        {
          "type": "WIN_DISTRIBUTED_LAG",
          "field": "display",
          "label": "display_ad",
          "order_by": [
            {
              "field": "week"
            }
          ],
          "params": {
            "kernel": "geometric",
            "decay": {
              "$var": "decay_display"
            },
            "max_lag": 13,
            "normalize": false
          }
        }
      ],
      "attributes": [
        {
          "type": "ATTR_FORMULA",
          "label": "tv_contrib",
          "expression": "coef(\"mmm\", \"tv_ad\") * hill(tv_ad, coef(\"mmm\", \"k:tv_ad\"), coef(\"mmm\", \"s:tv_ad\"))"
        },
        {
          "type": "ATTR_FORMULA",
          "label": "search_contrib",
          "expression": "coef(\"mmm\", \"search_ad\") * hill(search_ad, coef(\"mmm\", \"k:search_ad\"), coef(\"mmm\", \"s:search_ad\"))"
        },
        {
          "type": "ATTR_FORMULA",
          "label": "social_contrib",
          "expression": "coef(\"mmm\", \"social_ad\") * hill(social_ad, coef(\"mmm\", \"k:social_ad\"), coef(\"mmm\", \"s:social_ad\"))"
        },
        {
          "type": "ATTR_FORMULA",
          "label": "display_contrib",
          "expression": "coef(\"mmm\", \"display_ad\") * hill(display_ad, coef(\"mmm\", \"k:display_ad\"), coef(\"mmm\", \"s:display_ad\"))"
        }
      ],
      "return": {
        "preset": "standard"
      }
    }
  ],
  "optimize": [
    {
      "name": "allocation",
      "direction": "maximize",
      "variables": [
        {
          "name": "tv",
          "lower": "params.lo_tv",
          "upper": "params.hi_tv",
          "start": "params.mean_tv"
        },
        {
          "name": "search",
          "lower": "params.lo_search",
          "upper": "params.hi_search",
          "start": "params.mean_search"
        },
        {
          "name": "social",
          "lower": "params.lo_social",
          "upper": "params.hi_social",
          "start": "params.mean_social"
        },
        {
          "name": "display",
          "lower": "params.lo_display",
          "upper": "params.hi_display",
          "start": "params.mean_display"
        }
      ],
      "objective": "coef(\"mmm\", \"tv_ad\") * hill(params.mult_tv * tv, coef(\"mmm\", \"k:tv_ad\"), coef(\"mmm\", \"s:tv_ad\")) + coef(\"mmm\", \"search_ad\") * hill(params.mult_search * search, coef(\"mmm\", \"k:search_ad\"), coef(\"mmm\", \"s:search_ad\")) + coef(\"mmm\", \"social_ad\") * hill(params.mult_social * social, coef(\"mmm\", \"k:social_ad\"), coef(\"mmm\", \"s:social_ad\")) + coef(\"mmm\", \"display_ad\") * hill(params.mult_display * display, coef(\"mmm\", \"k:display_ad\"), coef(\"mmm\", \"s:display_ad\"))",
      "constraints": [
        {
          "expr": "tv + search + social + display - params.budget",
          "type": "eq"
        }
      ],
      "starts": 8,
      "rng_seed": 60
    }
  ]
}
