{
  "_meta": {
    "category": "features",
    "description": "Leakage-safe target encoding: the encoder runs after a train/test split with fit_on \"split == 0\", so only training rows feed the category means, and folds 5 encodes each training row out-of-fold; holdout outcomes never move a value and PULSE_FEAT_TARGET_LEAKAGE_RISK does not fire.",
    "intents": [
      "prepare"
    ],
    "name": "feat_target_encode_safe",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "FEAT_TARGET_ENCODE",
      "FEAT_TRAIN_TEST_SPLIT",
      "FILTER_INCLUDE"
    ],
    "tags": [
      "feature-engineering",
      "feature-pipeline",
      "leakage-risk",
      "pre-filter"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "category_target_mean",
      "label": "avg_encoded"
    },
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n_train"
    }
  ],
  "cohort": {
    "filename": "training_data.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_TRAIN_TEST_SPLIT",
      "params": {
        "ratios": [
          0.7,
          0.15,
          0.15
        ],
        "seed": 42
      }
    },
    {
      "type": "FEAT_TARGET_ENCODE",
      "field": "category",
      "label": "category_target_mean",
      "params": {
        "target": "price",
        "smoothing": 5.0,
        "fit_on": "split == 0",
        "folds": 5,
        "rng_seed": 42
      }
    }
  ],
  "filterers": [
    {
      "type": "FILTER_INCLUDE",
      "field": "split",
      "values": [
        "0"
      ]
    }
  ]

}
