{
  "_meta": {
    "category": "features",
    "description": "Replace a high-cardinality categorical with its empirical frequency so it can feed a numeric model without column blow-up.",
    "name": "feat_frequency_encode_city",
    "operators": [
      "AGG_AVERAGE",
      "AGG_MAX",
      "AGG_MIN",
      "FEAT_FREQUENCY_ENCODE"
    ],
    "tags": [
      "feature-engineering",
      "cardinality-analysis",
      "pre-filter"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "city_freq",
      "label": "mean_city_freq"
    },
    {
      "type": "AGG_MAX",
      "field": "city_freq",
      "label": "most_common_city_share"
    },
    {
      "type": "AGG_MIN",
      "field": "city_freq",
      "label": "rarest_city_share"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_FREQUENCY_ENCODE",
      "field": "city",
      "label": "city_freq"
    }
  ]

}
