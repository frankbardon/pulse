{
  "_meta": {
    "category": "features",
    "description": "Decompose order_date into calendar features and group by quarter to surface seasonality.",
    "name": "feat_date_features_seasonality",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "AGG_SUM",
      "FEAT_DATE_FEATURES",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "feature-engineering",
      "time-series",
      "pre-filter"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n_orders"
    },
    {
      "type": "AGG_SUM",
      "field": "revenue",
      "label": "total_revenue"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "order_date_dow",
      "label": "avg_dow"
    }
  ],
  "cohort": {
    "filename": "orders.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_DATE_FEATURES",
      "field": "order_date"
    }
  ],
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "order_date_quarter"
    }
  ],
  "sort": [
    {
      "field": "order_date_quarter"
    }
  ]

}
