{
  "_meta": {
    "category": "features",
    "description": "Expand a categorical region column into one-hot indicators, then filter on a derived indicator before counting survivors.",
    "name": "feat_one_hot_and_filter",
    "operators": [
      "AGG_COUNT",
      "FEAT_ONE_HOT",
      "FILTER_INCLUDE"
    ],
    "tags": [
      "feature-engineering",
      "pre-filter",
      "feature-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n_north"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_ONE_HOT",
      "field": "region"
    }
  ],
  "filterers": [
    {
      "type": "FILTER_INCLUDE",
      "field": "region_north",
      "values": [
        "1"
      ]
    }
  ]

}
