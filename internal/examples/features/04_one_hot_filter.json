{
  "_meta": {
    "category": "features",
    "description": "Expand the categorical region field into one-hot indicators with FEAT_ONE_HOT, then filter on one derived indicator (region_north) before counting the rows that remain.",
    "intents": [
      "prepare"
    ],
    "name": "feat_one_hot_and_filter",
    "operators": [
      "AGG_COUNT",
      "FEAT_ONE_HOT",
      "FILTER_INCLUDE"
    ],
    "tags": [
      "feature-engineering",
      "pre-filter",
      "feature-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n_north"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_ONE_HOT",
      "field": "region"
    }
  ],
  "filterers": [
    {
      "type": "FILTER_INCLUDE",
      "field": "region_north",
      "values": [
        "1"
      ]
    }
  ]

}
