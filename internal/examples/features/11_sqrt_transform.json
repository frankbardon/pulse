{
  "_meta": {
    "category": "features",
    "description": "Square-root variance-stabilising transform of the skewed transactions.pulse amount field via FEAT_SQRT, summarised with AGG_AVERAGE and AGG_STDDEV. A milder compression of the right tail than FEAT_LOG's log1p (01_log_transform.json), the usual choice for count-like data.",
    "intents": [
      "prepare",
      "distribution_shape"
    ],
    "name": "feat_sqrt_transform",
    "operators": [
      "AGG_AVERAGE",
      "AGG_STDDEV",
      "FEAT_SQRT"
    ],
    "tags": [
      "feature-engineering",
      "distribution-shape",
      "pre-filter",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "sqrt_amount",
      "label": "mean_sqrt_amount"
    },
    {
      "type": "AGG_STDDEV",
      "field": "sqrt_amount",
      "label": "stddev_sqrt_amount"
    }
  ],
  "cohort": {
    "filename": "transactions.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_SQRT",
      "field": "amount",
      "label": "sqrt_amount"
    }
  ]
}
