{
  "_meta": {
    "category": "features",
    "description": "Discretize age into four explicit life-stage buckets and aggregate income per stage.",
    "name": "feat_bucketize_explicit",
    "operators": [
      "AGG_COUNT",
      "AGG_MEDIAN",
      "FEAT_BUCKETIZE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "feature-engineering",
      "pre-filter"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    },
    {
      "type": "AGG_MEDIAN",
      "field": "income",
      "label": "median_income"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_BUCKETIZE",
      "field": "age",
      "label": "life_stage",
      "params": {
        "boundaries": [
          18,
          35,
          55
        ]
      }
    }
  ],
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "life_stage"
    }
  ],
  "sort": [
    {
      "field": "life_stage"
    }
  ]

}
