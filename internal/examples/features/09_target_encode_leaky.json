{
  "_meta": {
    "category": "features",
    "description": "Intentional leakage example: target-encode with no split at all; PULSE_FEAT_TARGET_LEAKAGE_RISK fires, as it does on every FEAT_TARGET_ENCODE.",
    "intents": [
      "prepare"
    ],
    "name": "feat_target_encode_leaky",
    "operators": [
      "AGG_AVERAGE",
      "FEAT_TARGET_ENCODE"
    ],
    "tags": [
      "feature-engineering",
      "leakage-risk",
      "pre-filter"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "TARGET_category",
      "label": "leaked_mean"
    }
  ],
  "cohort": {
    "filename": "training_data.pulse",
    "data_dir": ".data"
  },
  "features": [
    {
      "type": "FEAT_TARGET_ENCODE",
      "field": "category",
      "params": {
        "target": "price"
      }
    }
  ]

}
