{
  "_meta": {
    "category": "windows",
    "description": "Gains table on grouped rows: customers.pulse bucketed into income quartiles, then WIN_SHARE gives each quartile's share of total income (no order_by needed) and, with params.cumulative, the running share from the top quartile down; WIN_LIFT (base = the customer count) gives the cumulative lift, the running share of income over the running share of customers, 1 meaning no concentration (the top quarter holds about 47% of the income, a lift of about 1.87). A zero total or a zero base share reads null, never 0.",
    "intents": [
      "composition",
      "benchmark"
    ],
    "name": "win_share_lift_gains",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "AGG_SUM",
      "GROUP_QUANTILE",
      "WIN_LIFT",
      "WIN_SHARE"
    ],
    "tags": [
      "proportion-analysis",
      "financial",
      "window-operator",
      "buffered-pipeline"
    ]
  },
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_QUANTILE",
      "field": "income",
      "interval": 4
    }
  ],
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "customers"
    },
    {
      "type": "AGG_SUM",
      "field": "income",
      "label": "income_total"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "income",
      "label": "mean_income"
    }
  ],
  "windows": [
    {
      "type": "WIN_SHARE",
      "field": "income_total",
      "label": "income_share"
    },
    {
      "type": "WIN_SHARE",
      "field": "income_total",
      "label": "cum_income_share",
      "order_by": [
        {
          "field": "mean_income",
          "desc": true
        }
      ],
      "params": {
        "cumulative": true
      }
    },
    {
      "type": "WIN_LIFT",
      "field": "income_total",
      "label": "cum_lift",
      "order_by": [
        {
          "field": "mean_income",
          "desc": true
        }
      ],
      "params": {
        "base": "customers",
        "cumulative": true
      }
    }
  ],
  "sort": [
    {
      "field": "mean_income",
      "desc": true
    }
  ]
}
