{
  "_meta": {
    "category": "windows",
    "description": "Gains table on grouped rows with WIN_FORMULA: customers.pulse bucketed into income quartiles, WIN_SHARE takes each quartile's share of income and its share of customers, then WIN_FORMULA divides one share by the other (the quartile's lift, as WIN_LIFT gives it; about 1.87 for the top quarter) and subtracts them (the concentration gap). A formula reads the row's group keys and aggregation labels and only the windows listed before it; a null input reads null.",
    "intents": [
      "composition",
      "benchmark"
    ],
    "name": "win_formula_gains",
    "operators": [
      "AGG_COUNT",
      "AGG_SUM",
      "GROUP_QUANTILE",
      "WIN_FORMULA",
      "WIN_SHARE"
    ],
    "tags": [
      "proportion-analysis",
      "financial",
      "window-operator",
      "buffered-pipeline"
    ]
  },
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_QUANTILE",
      "field": "income",
      "interval": 4
    }
  ],
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "customers"
    },
    {
      "type": "AGG_SUM",
      "field": "income",
      "label": "income_total"
    }
  ],
  "windows": [
    {
      "type": "WIN_SHARE",
      "field": "income_total",
      "label": "income_share"
    },
    {
      "type": "WIN_SHARE",
      "field": "customers",
      "label": "customer_share"
    },
    {
      "type": "WIN_FORMULA",
      "label": "lift",
      "params": {
        "expression": "income_share / customer_share"
      }
    },
    {
      "type": "WIN_FORMULA",
      "label": "concentration_gap",
      "params": {
        "expression": "income_share - customer_share"
      }
    }
  ],
  "sort": [
    {
      "field": "income_total",
      "desc": true
    }
  ]
}
