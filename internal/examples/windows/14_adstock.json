{
  "_meta": {
    "category": "windows",
    "description": "Media adstock of revenue over the date-ordered series: a geometric carry-over (decay 0.6) beside a delayed-peak Weibull PDF kernel, both normalised over 8 lags.",
    "intents": [
      "prepare"
    ],
    "name": "win_adstock",
    "operators": [
      "WIN_ADSTOCK"
    ],
    "tags": [
      "time-series",
      "feature-engineering",
      "window-operator",
      "buffered-pipeline"
    ]
  },
  "cohort": {
    "filename": "orders.pulse",
    "data_dir": ".data"
  },
  "sort": [
    {
      "field": "order_date"
    }
  ],
  "windows": [
    {
      "type": "WIN_ADSTOCK",
      "field": "revenue",
      "label": "revenue_adstock_geometric",
      "order_by": [
        {
          "field": "order_date"
        }
      ],
      "params": {
        "kernel": "geometric",
        "decay": 0.6,
        "max_lag": 8
      }
    },
    {
      "type": "WIN_ADSTOCK",
      "field": "revenue",
      "label": "revenue_adstock_weibull",
      "order_by": [
        {
          "field": "order_date"
        }
      ],
      "params": {
        "kernel": "weibull_pdf",
        "shape": 2,
        "scale": 3,
        "max_lag": 8
      }
    }
  ]

}
