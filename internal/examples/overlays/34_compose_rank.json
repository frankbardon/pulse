{
  "_meta": {
    "category": "overlays",
    "description": "Compose batch on experiment.pulse of total_pop (every row) and audience_a (the variant arm), region x segment count crosstabs, decorated with an OVERLAY_RANK cell overlay: the 1-based rank of each audience_a cell (1 = largest) within params.population (row, column or matrix; default matrix). The rank reads only the target's cells; the reference slot anchors the label and key alignment checks. Ties take the average rank (scipy.stats.rankdata's default); absent cells stay absent and do not count. Buffered.",
    "intents": [
      "benchmark"
    ],
    "name": "compose-rank",
    "operators": [
      "AGG_COUNT",
      "FILTER_INCLUDE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "compose",
      "cross-tabulation",
      "overlay",
      "top-n"
    ]
  },
  "requests": [
    {
      "label": "total_pop",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "segment"
          }
        ],
        "cell": {
          "type": "AGG_COUNT",
          "field": "id",
          "label": "n"
        },
        "margins": {
          "rows": true,
          "columns": true,
          "grand": true
        }
      }
    },
    {
      "label": "audience_a",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": ["variant"]
        }
      ],
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "segment"
          }
        ],
        "cell": {
          "type": "AGG_COUNT",
          "field": "id",
          "label": "n"
        },
        "margins": {
          "rows": true,
          "columns": true,
          "grand": true
        }
      }
    }
  ],
  "overlays": [
    {
      "name": "audience_rank",
      "kind": "OVERLAY_RANK",
      "scope": "cell",
      "reference": "total_pop",
      "targets": ["audience_a"],
      "params": {
        "population": "matrix"
      }
    }
  ]
}
