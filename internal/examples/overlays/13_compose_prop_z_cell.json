{
  "_meta": {
    "category": "overlays",
    "description": "Compose batch of two crosstab slots, the control and variant arms of experiment.pulse, over region x converted (count cells) decorated with an OVERLAY_PROP_Z_CELL cell overlay: a pooled two-proportion z-test of each variant cell against the matching control cell, the cell the successes and the row margin the n. The yes column so tests each region's conversion rate between the arms (p 0.42 to 0.99 here: no region converts differently) and the no column mirrors it. Each overlay cell is the two-sided p-value TEST_PROP_Z gives for the same counts. A degenerate cell (pooled proportion 0 or 1, no row margin) reads null with one PULSE_OVERLAY_REF_ZERO each. Buffered.",
    "intents": [
      "compare_groups",
      "benchmark"
    ],
    "name": "compose-prop-z-cell",
    "operators": [
      "AGG_COUNT",
      "FILTER_INCLUDE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "cohort-analysis",
      "composed",
      "cross-tabulation",
      "hypothesis-test",
      "overlay",
      "proportion-analysis"
    ]
  },
  "requests": [
    {
      "label": "control",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": [
            "control"
          ]
        }
      ],
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "converted"
          }
        ],
        "cell": {
          "type": "AGG_COUNT",
          "field": "id",
          "label": "n"
        },
        "margins": {
          "rows": true,
          "columns": true,
          "grand": true
        }
      }
    },
    {
      "label": "variant",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": [
            "variant"
          ]
        }
      ],
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "converted"
          }
        ],
        "cell": {
          "type": "AGG_COUNT",
          "field": "id",
          "label": "n"
        },
        "margins": {
          "rows": true,
          "columns": true,
          "grand": true
        }
      }
    }
  ],
  "overlays": [
    {
      "name": "prop_z",
