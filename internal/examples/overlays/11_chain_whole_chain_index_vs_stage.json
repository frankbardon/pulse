{
  "_meta": {
    "category": "overlays",
    "description": "3-stage process chain on experiment.pulse with one whole-chain OVERLAY_INDEX_VS_STAGE (ref.index 0, target.index 2): 100 * stage-2 value / stage-0 value per region. Every stage groups by region with one scalar aggregation, the shape the whole-chain gate accepts: stage 0 sums revenue (v), stage 1 sums v (w), stage 2 sums w (c). Re-summing a per-region total keeps it, so every index reads 100: the chain reconciles. The layer lands on the chain response's overlays after every stage finishes; a stage's own overlays are separate. Buffered.",
    "intents": [
      "benchmark"
    ],
    "name": "chain-whole-chain-index-vs-stage",
    "operators": [
      "AGG_SUM",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "cohort-analysis",
      "composed",
      "overlay"
    ]
  },
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "stages": [
    {
      "name": "stage_a",
      "request": {
        "groups": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "aggregations": [
          {
            "type": "AGG_SUM",
            "field": "revenue",
            "label": "v"
          }
        ]
      }
    },
    {
      "name": "stage_b",
      "request": {
        "groups": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "aggregations": [
          {
            "type": "AGG_SUM",
            "field": "v",
            "label": "w"
          }
        ]
      }
    },
    {
      "name": "stage_c",
      "request": {
        "groups": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "aggregations": [
          {
            "type": "AGG_SUM",
            "field": "w",
            "label": "c"
          }
        ]
      }
    }
  ],
  "overlays": [
    {
      "name": "stage2_vs_stage0_index",
      "kind": "OVERLAY_INDEX_VS_STAGE",
      "scope": "group",
      "ref": {
        "index": 0
      },
      "target": {
        "index": 2
      }
    }
  ]
}
