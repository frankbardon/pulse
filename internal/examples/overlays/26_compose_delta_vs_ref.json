{
  "_meta": {
    "category": "overlays",
    "description": "Compose batch of two crosstab slots over region x segment on experiment.pulse, the control and variant arms, decorated with an OVERLAY_DELTA_VS_REF cell overlay: variant cell - control cell, in counts. Subtractive twin of OVERLAY_INDEX_VS_REF (12_compose_audience_index_vs_total.json), with the same label, key and schema checks; subtraction is defined for a zero reference, so it never emits PULSE_OVERLAY_REF_ZERO. Buffered; renderers centre colour ramps on baseline 0.",
    "intents": [
      "benchmark"
    ],
    "name": "compose-delta-vs-ref",
    "operators": [
      "AGG_COUNT",
      "FILTER_INCLUDE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "compose",
      "comparison",
      "cross-tabulation",
      "overlay"
    ]
  },
  "requests": [
    {
      "label": "control",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": [
            "control"
          ]
        }
      ],
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "segment"
          }
        ],
        "cell": {
          "type": "AGG_COUNT",
          "field": "id",
          "label": "n"
        },
        "margins": {
          "rows": true,
          "columns": true,
          "grand": true
        }
      }
    },
    {
      "label": "variant",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": [
            "variant"
          ]
        }
      ],
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "segment"
          }
        ],
        "cell": {
          "type": "AGG_COUNT",
          "field": "id",
          "label": "n"
        },
        "margins": {
          "rows": true,
          "columns": true,
          "grand": true
        }
      }
    }
  ],
  "overlays": [
    {
      "name": "variant_minus_control",
      "kind": "OVERLAY_DELTA_VS_REF",
      "scope": "cell",
      "reference": "control",
      "targets": [
        "variant"
      ]
    }
  ]
}
