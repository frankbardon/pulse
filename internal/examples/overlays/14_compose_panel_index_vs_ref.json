{
  "_meta": {
    "category": "overlays",
    "description": "Compose batch on experiment.pulse of one reference slot (total_pop, every row) and three targets (audience_a the variant arm, audience_b segment_a, audience_c the converters), each summing revenue by region, decorated with an OVERLAY_PANEL_INDEX_VS_REF group overlay: one OVERLAY_INDEX_VS_REF layer per target, named <name>__<target> in target order, each 100 * target revenue / total_pop revenue per region (the share of each region's revenue the audience brings). OVERLAY_PROP_Z_PANEL (31_compose_prop_z_panel.json) packs a panel into one layer instead. At most 16 targets by default (PULSE_OVERLAY_PANEL_TARGETS_OVER_CAP). Streamable on this series shape.",
    "intents": [
      "benchmark",
      "compare_groups"
    ],
    "name": "compose-panel-index-vs-ref",
    "operators": [
      "AGG_SUM",
      "FILTER_INCLUDE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "cohort-analysis",
      "composed",
      "overlay",
      "streaming-friendly"
    ]
  },
  "requests": [
    {
      "label": "total_pop",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "aggregations": [
        {
          "type": "AGG_SUM",
          "field": "revenue",
          "label": "revenue"
        }
      ],
      "groups": [
        {
          "type": "GROUP_CATEGORY",
          "field": "region"
        }
      ]
    },
    {
      "label": "audience_a",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": ["variant"]
        }
      ],
      "aggregations": [
        {
          "type": "AGG_SUM",
          "field": "revenue",
          "label": "revenue"
        }
      ],
      "groups": [
        {
          "type": "GROUP_CATEGORY",
          "field": "region"
        }
      ]
    },
    {
      "label": "audience_b",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "segment",
          "values": ["segment_a"]
        }
      ],
      "aggregations": [
        {
          "type": "AGG_SUM",
          "field": "revenue",
          "label": "revenue"
        }
      ],
      "groups": [
        {
          "type": "GROUP_CATEGORY",
          "field": "region"
        }
      ]
    },
    {
      "label": "audience_c",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "converted",
          "values": ["yes"]
        }
      ],
      "aggregations": [
        {
          "type": "AGG_SUM",
          "field": "revenue",
          "label": "revenue"
        }
      ],
      "groups": [
        {
          "type": "GROUP_CATEGORY",
          "field": "region"
        }
      ]
    }
  ],
  "overlays": [
    {
      "name": "audience_panel_index",
      "kind": "OVERLAY_PANEL_INDEX_VS_REF",
      "scope": "group",
      "reference": "total_pop",
      "targets": ["audience_a", "audience_b", "audience_c"]
    }
  ]
}
