{
  "_meta": {
    "category": "overlays",
    "description": "Compose batch of two crosstab slots on experiment.pulse, the control and variant arms, each an AGG_WELFORD of revenue by region x segment, decorated with an OVERLAY_T_CELL cell overlay: a Welch t-test of each variant cell against the matching control cell, read from the cells' {mean, variance, n}, so it needs no variance or n params. Each overlay cell is the two-sided p-value TEST_WELCH gives on the same moments: se = sqrt(var_t/n_t + var_r/n_r), t = (mean_t - mean_r) / se, Welch-Satterthwaite df. A cell with n < 2, zero variance or no reference reads null with one PULSE_OVERLAY_REF_ZERO each. Buffered.",
    "intents": [
      "compare_groups"
    ],
    "name": "pairwise-welch-matrix",
    "operators": [
      "AGG_WELFORD",
      "FILTER_INCLUDE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "byte-equal-test",
      "compose",
      "crosstab",
      "hypothesis-test",
      "overlay",
      "parametric",
      "t-test",
      "two-sample",
      "welch",
      "welford-triple"
    ]
  },
  "requests": [
    {
      "label": "control",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": ["control"]
        }
      ],
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "segment"
          }
        ],
        "cell": {
          "type": "AGG_WELFORD",
          "field": "revenue",
          "label": "revenue_triple"
        }
      }
    },
    {
      "label": "variant",
      "cohort": {
        "filename": "experiment.pulse",
        "data_dir": ".data"
      },
      "filterers": [
        {
          "type": "FILTER_INCLUDE",
          "field": "treatment",
          "values": ["variant"]
        }
      ],
      "crosstab": {
        "rows": [
          {
            "type": "GROUP_CATEGORY",
            "field": "region"
          }
        ],
        "columns": [
          {
            "type": "GROUP_CATEGORY",
            "field": "segment"
          }
        ],
        "cell": {
          "type": "AGG_WELFORD",
          "field": "revenue",
          "label": "revenue_triple"
        }
      }
    }
  ],
  "overlays": [
    {
      "name": "welch_pairwise",
      "kind": "OVERLAY_T_CELL",
      "scope": "cell",
      "reference": "control",
      "targets": ["variant"]
    }
  ]
}
