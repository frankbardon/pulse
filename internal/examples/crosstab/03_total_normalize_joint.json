{
  "_meta": {
    "category": "crosstab",
    "description": "Segment × converted count crosstab with total normalization. Whole table sums to 1; each cell is the joint probability P(segment=s, converted=c).",
    "name": "crosstab_total_normalize_joint",
    "operators": [
      "AGG_COUNT",
      "GROUP_CATEGORY"
    ],
    "tags": [
