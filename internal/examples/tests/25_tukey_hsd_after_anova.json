{
  "_meta": {
    "category": "tests",
    "description": "Tier-2 Tukey HSD pairwise comparisons over per-region means after a tier-1 one-way ANOVA on the same Process call.",
    "name": "tukey_hsd_after_anova",
    "operators": [
      "AGG_AVERAGE",
      "AGG_COUNT",
      "GROUP_CATEGORY",
      "TEST_ANOVA_F",
      "TEST_TUKEY_HSD"
    ],
    "tags": [
      "hypothesis-test",
      "tier-2-test",
      "parametric",
      "post-hoc",
      "k-sample",
      "experiment-analysis",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "revenue",
      "label": "avg_revenue"
    },
    {
      "type": "AGG_COUNT",
      "field": "revenue",
      "label": "n"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "region"
    }
  ],
  "post_tests": [
    {
      "type": "TEST_TUKEY_HSD",
      "field": "avg_revenue",
      "split_by": "region",
      "alpha": 0.05,
      "label": "regional_tukey",
      "params": {
        "ms_within": 6000.0,
        "df_within": 396.0
      }
    }
  ],
  "tests": [
    {
      "type": "TEST_ANOVA_F",
      "field": "revenue",
      "split_by": "region",
      "alpha": 0.05,
      "label": "regional_anova"
    }
  ]

}
