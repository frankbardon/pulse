{
  "_meta": {
    "category": "tests",
    "description": "One-way repeated-measures ANOVA on a 40-subject by 3-condition design where the subject effect dominates the residual.",
    "name": "rm_anova_three_conditions",
    "operators": [
      "AGG_AVERAGE",
      "TEST_ANOVA_RM"
    ],
    "tags": [
      "hypothesis-test",
      "tier-1-test",
      "parametric",
      "repeated-measures",
      "k-sample",
      "before-after",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "metric",
      "label": "avg_metric"
    }
  ],
  "cohort": {
    "filename": "repeated_measures.pulse",
    "data_dir": ".data"
  },
  "tests": [
    {
      "type": "TEST_ANOVA_RM",
      "field": "metric",
      "split_by": "condition",
      "subject_field": "subject_id",
      "alpha": 0.05,
      "label": "metric_rm_anova"
    }
  ]

}
