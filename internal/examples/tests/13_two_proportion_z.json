{
  "_meta": {
    "category": "tests",
    "description": "Two-proportion z-test on conversion rate by treatment, using params.success to name the positive outcome.",
    "name": "two_proportion_z",
    "operators": [
      "TEST_PROP_Z"
    ],
    "tags": [
      "hypothesis-test",
      "tier-1-test",
      "parametric",
      "proportion-analysis",
      "two-sample",
      "experiment-analysis",
      "streaming-friendly"
    ]
  },
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "tests": [
    {
      "type": "TEST_PROP_Z",
      "field": "converted",
      "split_by": "treatment",
      "alpha": 0.05,
      "label": "conversion_lift_z",
      "params": {
        "success": "yes"
      }
    }
  ]

}
