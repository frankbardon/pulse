{
  "_meta": {
    "category": "tests",
    "description": "Fisher exact test beside the chi-square on a 2x2 treatment x converted table filtered to a small subgroup (segment_a in the north region: 31 rows, 5 conversions, smallest expected count about 2.3). With an expected count below 5 the chi-square's large-sample p (about 0.22 here) is unreliable; Fisher's exact p (about 0.34) is the one to read.",
    "intents": [
      "relationship"
    ],
    "name": "fisher_exact_small_sample",
    "operators": [
      "AGG_COUNT",
      "FILTER_INCLUDE",
      "TEST_CHISQ",
      "TEST_FISHER_EXACT"
    ],
    "tags": [
      "hypothesis-test",
      "tier-1-test",
      "exact-test",
      "small-sample",
      "cross-tabulation",
      "proportion-analysis",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "revenue",
      "label": "n"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "filterers": [
    {
      "type": "FILTER_INCLUDE",
      "field": "segment",
      "values": [
        "segment_a"
      ]
    },
    {
      "type": "FILTER_INCLUDE",
      "field": "region",
      "values": [
        "north"
      ]
    }
  ],
  "tests": [
    {
      "type": "TEST_CHISQ",
      "rows": "treatment",
      "cols": "converted",
      "alpha": 0.05,
      "label": "chisq_small_n"
    },
    {
      "type": "TEST_FISHER_EXACT",
      "rows": "treatment",
      "cols": "converted",
      "alpha": 0.05,
      "label": "fisher_exact_small_n"
    }
  ]
}
