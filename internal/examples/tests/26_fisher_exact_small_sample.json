{
  "_meta": {
    "category": "tests",
    "description": "Fisher exact test alongside chi-square on a 2x2 contingency table that has been filtered down to a small subgroup.",
    "name": "fisher_exact_small_sample",
    "operators": [
      "AGG_COUNT",
      "FILTER_INCLUDE",
      "TEST_CHISQ",
      "TEST_FISHER_EXACT"
    ],
    "tags": [
      "hypothesis-test",
      "tier-1-test",
      "exact-test",
      "small-sample",
      "cross-tabulation",
      "proportion-analysis",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "revenue",
      "label": "n"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "filterers": [
    {
      "type": "FILTER_INCLUDE",
      "field": "segment",
      "values": [
        "segment_a"
      ]
    }
  ],
  "tests": [
    {
      "type": "TEST_CHISQ",
      "rows": "treatment",
      "cols": "converted",
      "alpha": 0.05,
      "label": "chisq_small_n"
    },
    {
      "type": "TEST_FISHER_EXACT",
      "rows": "treatment",
      "cols": "converted",
      "alpha": 0.05,
      "label": "fisher_exact_small_n"
    }
  ]

}
