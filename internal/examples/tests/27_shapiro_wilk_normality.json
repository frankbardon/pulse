{
  "_meta": {
    "category": "tests",
    "description": "Shapiro-Wilk (Shapiro-Francia variant) normality check on revenue split by treatment, used as a pre-flight gate for parametric tests.",
    "name": "shapiro_wilk_normality",
    "operators": [
      "AGG_COUNT",
      "TEST_SHAPIRO_WILK"
    ],
    "tags": [
      "hypothesis-test",
      "tier-1-test",
      "normality-test",
      "distribution-shape",
      "experiment-analysis",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "revenue",
      "label": "n"
    }
  ],
  "cohort": {
    "filename": "experiment.pulse",
    "data_dir": ".data"
  },
  "tests": [
    {
      "type": "TEST_SHAPIRO_WILK",
      "field": "revenue",
      "split_by": "treatment",
      "alpha": 0.05,
      "label": "revenue_shapiro"
    }
  ]

}
