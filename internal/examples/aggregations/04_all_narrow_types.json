{
  "_meta": {
    "category": "aggregations",
    "description": "One AGG_SUM or AGG_AVERAGE on each narrow numeric field type (u8, u16, u32, u64, f32, f64, u4 and packed_bool) of all_types.pulse in one request; a packed_bool sums as 0/1, and every figure is a float64, so the u64 sum (past 2^53) is rounded.",
    "intents": [
      "describe"
    ],
    "name": "all_narrow_types",
    "operators": [
      "AGG_AVERAGE",
      "AGG_SUM"
    ],
    "tags": [
      "data-quality",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_SUM",
      "field": "small_int",
      "label": "u8_sum"
    },
    {
      "type": "AGG_SUM",
      "field": "medium_int",
      "label": "u16_sum"
    },
    {
      "type": "AGG_SUM",
      "field": "big_int",
      "label": "u32_sum"
    },
    {
      "type": "AGG_SUM",
      "field": "huge_int",
      "label": "u64_sum"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "measurement",
      "label": "f32_avg"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "precise_value",
      "label": "f64_avg"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "small_grade",
      "label": "grade_avg"
    },
    {
      "type": "AGG_SUM",
      "field": "active",
      "label": "active_n"
    }
  ],
  "cohort": {
    "filename": "all_types.pulse",
    "data_dir": ".data"
  }
}
