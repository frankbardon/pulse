{
  "_meta": {
    "category": "aggregations",
    "description": "Decimal-aware AGG_SUM, AGG_AVERAGE, AGG_MIN and AGG_MAX on a decimal128 money field: each figure is a decimal string at the field scale (the average banker-rounded at a wider scale).",
    "intents": [
      "describe"
    ],
    "name": "decimal_sum",
    "operators": [
      "AGG_AVERAGE",
      "AGG_MAX",
      "AGG_MIN",
      "AGG_SUM"
    ],
    "tags": [
      "financial",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_SUM",
      "field": "amount",
      "label": "total"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "amount",
      "label": "avg"
    },
    {
      "type": "AGG_MIN",
      "field": "amount",
      "label": "lo"
    },
    {
      "type": "AGG_MAX",
      "field": "amount",
      "label": "hi"
    }
  ],
  "cohort": {
    "filename": "all_types.pulse",
    "data_dir": ".data"
  }

}
