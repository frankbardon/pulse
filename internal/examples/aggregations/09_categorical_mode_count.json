{
  "_meta": {
    "category": "aggregations",
    "description": "Per city, how many customers share the most common region (AGG_MODE_COUNT, a scalar modal count; its components add distinct_count, mode_value and mode_count) and which region that is (AGG_MODE). For a count per region, group by region and use AGG_COUNT instead.",
    "intents": [
      "composition",
      "describe"
    ],
    "name": "categorical_mode_count",
    "operators": [
      "AGG_MODE_COUNT",
      "AGG_MODE",
      "GROUP_CATEGORY"
    ],
    "tags": [
      "cardinality-analysis",
      "cohort-analysis",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_MODE_COUNT",
      "field": "region",
      "label": "region_mode_count"
    },
    {
      "type": "AGG_MODE",
      "field": "region",
      "label": "modal_region"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "city"
    }
  ],
  "sort": [
    {
      "field": "city"
    }
  ]
}
