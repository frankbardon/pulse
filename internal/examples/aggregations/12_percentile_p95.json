{
  "_meta": {
    "category": "aggregations",
    "description": "The 95th percentile of transactions.pulse amount beside AGG_AVERAGE and AGG_MAX, to show the gap between the tail and the mean. AGG_PERCENTILE requires params.percentile in 0..100 (50 is the median); a missing one is PROCESSING_CONFIG. Buffered: it needs every value.",
    "intents": [
      "distribution_shape",
      "describe"
    ],
    "name": "percentile_p95",
    "operators": [
      "AGG_AVERAGE",
      "AGG_MAX",
      "AGG_PERCENTILE"
    ],
    "tags": [
      "distribution-shape",
      "outlier-detection",
      "financial",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "amount",
      "label": "mean_amount"
    },
    {
      "type": "AGG_MAX",
      "field": "amount",
      "label": "max_amount"
    },
    {
      "type": "AGG_PERCENTILE",
      "field": "amount",
      "label": "p95_amount",
      "params": {
        "percentile": 95
      }
    }
  ],
  "cohort": {
    "filename": "transactions.pulse",
    "data_dir": ".data"
  }
}
