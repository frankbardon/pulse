{
  "_meta": {
    "category": "aggregations",
    "description": "Run DISTINCT_COUNT and MODE across categorical_u8/u16/u32 widths and a date column to exercise every dictionary lookup path.",
    "name": "categorical_breakdown",
    "operators": [
      "AGG_DISTINCT_COUNT",
      "AGG_MODE"
    ],
    "tags": [
      "cardinality-analysis",
      "cross-tabulation",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "region",
      "label": "distinct_regions"
    },
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "city",
      "label": "distinct_cities"
    },
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "sku",
      "label": "distinct_skus"
    },
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "event_date",
      "label": "distinct_dates"
    },
    {
      "type": "AGG_MODE",
      "field": "region",
      "label": "modal_region"
    }
  ],
  "cohort": {
    "filename": "all_types.pulse",
    "data_dir": ".data"
  }

}
