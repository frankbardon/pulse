{
  "_meta": {
    "category": "aggregations",
    "description": "AGG_DISTINCT_COUNT across categorical_u8 / u16 / u32 fields and a date field, plus AGG_MODE on region, exercising every dictionary width. AGG_MODE over a categorical returns the modal level's dictionary index, not its label.",
    "intents": [
      "describe",
      "composition"
    ],
    "name": "categorical_breakdown",
    "operators": [
      "AGG_DISTINCT_COUNT",
      "AGG_MODE"
    ],
    "tags": [
      "cardinality-analysis",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "region",
      "label": "distinct_regions"
    },
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "city",
      "label": "distinct_cities"
    },
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "sku",
      "label": "distinct_skus"
    },
    {
      "type": "AGG_DISTINCT_COUNT",
      "field": "event_date",
      "label": "distinct_dates"
    },
    {
      "type": "AGG_MODE",
      "field": "region",
      "label": "modal_region"
    }
  ],
  "cohort": {
    "filename": "all_types.pulse",
    "data_dir": ".data"
  }

}
