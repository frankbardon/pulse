{
  "_meta": {
    "category": "filterers",
    "description": "Keep only orders whose order_date falls in the launch (2025 Q1) or growth (2025 Q2-Q3) phase with FILTER_DATE_RANGES inline labelled ranges, then summarize the kept orders.",
    "intents": [
      "change_over_time",
      "segment"
    ],
    "name": "filter_date_ranges_phases",
    "operators": [
      "AGG_COUNT",
      "AGG_SUM",
      "FILTER_DATE_RANGES"
    ],
    "tags": [
      "cohort-analysis",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    },
    {
      "type": "AGG_SUM",
      "field": "revenue",
      "label": "total"
    }
  ],
  "cohort": {
    "filename": "orders.pulse",
    "data_dir": ".data"
  },
  "filterers": [
    {
      "type": "FILTER_DATE_RANGES",
      "field": "order_date",
      "params": {
        "ranges": [
          { "label": "launch", "start": "2025-01-01", "end": "2025-03-31" },
          { "label": "growth", "start": "2025-04-01", "end": "2025-09-30" }
        ]
      }
    }
  ]
}
