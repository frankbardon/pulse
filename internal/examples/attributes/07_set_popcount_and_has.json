{
  "_meta": {
    "category": "attributes",
    "description": "Three per-row metrics from a set_u8 multi-select field: ATTR_SET_POPCOUNT gives wallet size, ATTR_SET_HAS a 0/1 indicator for one label (VISA), and ATTR_FORMULA's built-in has_any helper a 0/1 indicator for VISA or MC. All three are aggregated across the cohort.",
    "intents": [
      "prepare",
      "describe"
    ],
    "name": "attr_set_popcount_and_has",
    "operators": [
      "AGG_AVERAGE",
      "AGG_SUM",
      "ATTR_FORMULA",
      "ATTR_SET_HAS",
      "ATTR_SET_POPCOUNT"
    ],
    "tags": [
      "feature-engineering",
      "streaming-friendly"
    ]
  },
  "cohort": {
    "filename": "card_issuers.pulse",
    "data_dir": ".data"
  },
  "attributes": [
    {
      "type": "ATTR_SET_POPCOUNT",
      "field": "issuers",
      "label": "wallet_size"
    },
    {
      "type": "ATTR_SET_HAS",
      "field": "issuers",
      "label": "has_visa",
      "params": {"label": "VISA"}
    },
    {
      "type": "ATTR_FORMULA",
      "field": "issuers",
      "label": "has_visa_or_mc",
      "expression": "has_any(issuers, 'VISA', 'MC')"
    }
  ],
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "wallet_size",
      "label": "avg_wallet_size"
    },
    {
      "type": "AGG_SUM",
      "field": "has_visa",
      "label": "visa_holders"
    },
    {
      "type": "AGG_SUM",
      "field": "has_visa_or_mc",
      "label": "visa_or_mc_holders"
    }
  ]
}
