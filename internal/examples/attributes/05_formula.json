{
  "_meta": {
    "category": "attributes",
    "description": "Derive monthly income via the expr-lang formula engine and aggregate the resulting per-record value.",
    "name": "attr_formula_monthly",
    "operators": [
      "AGG_AVERAGE",
      "AGG_MAX",
      "ATTR_FORMULA"
    ],
    "tags": [
      "feature-engineering",
      "streaming-friendly"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "monthly_income",
      "label": "avg_monthly"
    },
    {
      "type": "AGG_MAX",
      "field": "monthly_income",
      "label": "max_monthly"
    }
  ],
  "attributes": [
    {
      "type": "ATTR_FORMULA",
      "field": "income",
      "label": "monthly_income",
      "expression": "income / 12"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  }

}
