{
  "_meta": {
    "category": "attributes",
    "description": "Convert age to a t-score (z*10 + 50) so the output centers at 50 with stddev 10.",
    "name": "tscore",
    "operators": [
      "AGG_AVERAGE",
      "AGG_STDDEV",
      "ATTR_TSCORE"
    ],
    "tags": [
      "distribution-shape",
      "buffered-pipeline"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "age_t",
      "label": "mean_t"
    },
    {
      "type": "AGG_STDDEV",
      "field": "age_t",
      "label": "stddev_t"
    }
  ],
  "attributes": [
    {
      "type": "ATTR_TSCORE",
      "field": "age",
      "label": "age_t"
    }
  ],
  "cohort": {
    "filename": "customers.pulse",
    "data_dir": ".data"
  }

}
