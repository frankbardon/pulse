{
  "_meta": {
    "category": "groupers",
    "description": "Bucket orders into named phases using GROUP_DATE_RANGES inline labelled ranges (launch from 2025-02-01, growth, then an open-ended steady phase); January orders, before every range, land in the unmatched bucket named by unmatched_label (pre_launch).",
    "intents": [
      "change_over_time",
      "composition"
    ],
    "name": "group_date_ranges_phases",
    "operators": [
      "AGG_COUNT",
      "AGG_SUM",
      "GROUP_DATE_RANGES"
    ],
    "tags": [
      "time-series",
      "cohort-analysis"
    ]
  },
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "id",
      "label": "n"
    },
    {
      "type": "AGG_SUM",
      "field": "revenue",
      "label": "total"
    }
  ],
  "cohort": {
    "filename": "orders.pulse",
    "data_dir": ".data"
  },
  "groups": [
    {
      "type": "GROUP_DATE_RANGES",
      "field": "order_date",
      "params": {
        "ranges": [
          { "label": "launch", "start": "2025-02-01", "end": "2025-04-30" },
          { "label": "growth", "start": "2025-05-01", "end": "2025-09-30" },
          { "label": "steady", "start": "2025-10-01" }
        ],
        "unmatched_label": "pre_launch"
      }
    }
  ]
}
