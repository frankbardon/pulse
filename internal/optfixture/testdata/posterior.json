{
  "requests": [
    {"label": "weeks", "cohort": {"filename": "opt_price.pulse"}, "aggregations": [{"type": "AGG_COUNT", "field": "week", "label": "n"}]}
  ],
  "params": {"budget": 100},
  "optimize": [
    {
      "name": "allocation",
      "direction": "maximize",
      "models": [{"name": "mmm", "path": "models/mmm_bayes.pulse-model.json"}],
      "variables": [
        {"name": "tv", "lower": 0, "upper": 100},
        {"name": "search", "lower": 0, "upper": 100}
      ],
      "objective": "response(\"mmm\", \"tv\", tv) + response(\"mmm\", \"search\", search)",
      "constraints": [{"expr": "tv + search - params.budget", "type": "eq"}],
      "posterior": {"objective": "quantile", "q": 0.2},
      "starts": 3,
      "rng_seed": 5
    }
  ]
}
