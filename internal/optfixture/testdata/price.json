{
  "requests": [
    {"label": "weeks", "cohort": {"filename": "opt_price.pulse"}, "aggregations": [{"type": "AGG_COUNT", "field": "week", "label": "n"}]}
  ],
  "params": {"cost": 5},
  "fits": [
    {"name": "demand", "request": {"cohort": {"filename": "opt_price.pulse"}, "regressions": [{"type": "REG_OLS", "target": "units", "predictors": ["price"]}]}}
  ],
  "optimize": [
    {
      "name": "price",
      "direction": "maximize",
      "variables": [{"name": "p", "lower": 1, "upper": 30}],
      "objective": "(p - params.cost) * (coef(\"demand\", \"(intercept)\") + coef(\"demand\", \"price\") * p)",
      "starts": 4,
      "rng_seed": 7
    }
  ]
}
